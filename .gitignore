/android/app/release

# Widget Preview related
.widget_preview/

# ComicRedr
# Real comics are fetched, never committed (design plan section 10).
/test/corpus/
/test/corpus-train/
/test/corpus-modern/
# Spike outputs, regenerated by the scripts in spike/.
/spike/synthetic/
/spike/pages/
/spike/out/
/spike/eval_pages/
/spike/train_pages/
__pycache__/
# The release keystore must be backed up, never committed.
*.jks
*.keystore
/android/key.properties
# The detector model is packed into the app from here but not committed:
# it starts from a Manga109-trained model (README, step 7).
/assets/models/*.onnx
