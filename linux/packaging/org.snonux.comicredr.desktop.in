[Desktop Entry]
Type=Application
Name=ComicRedr
GenericName=Comic Book Reader
Comment=Read CBZ, CBT, EPUB, PDF, image and folder comics, panel by panel
Exec=@BINDIR@/comicredr %f
TryExec=@BINDIR@/comicredr
Icon=org.snonux.comicredr
Terminal=false
StartupWMClass=org.snonux.comicredr
Categories=Graphics;Viewer;
MimeType=application/vnd.comicbook+zip;application/x-cbz;application/x-cbt;application/epub+zip;application/pdf;image/png;image/jpeg;image/webp;inode/directory;
Keywords=comic;comics;cbz;cbt;epub;pdf;reader;guided;panel;
