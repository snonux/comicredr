[Desktop Entry]
Type=Application
Name=ComicRedr
GenericName=Comic Book Reader
Comment=Read CBZ, PDF and folder comics, panel by panel
Exec=@BINDIR@/comicredr %f
TryExec=@BINDIR@/comicredr
Icon=org.snonux.comicredr
Terminal=false
StartupWMClass=org.snonux.comicredr
Categories=Graphics;Viewer;
MimeType=application/vnd.comicbook+zip;application/x-cbz;application/pdf;
Keywords=comic;comics;cbz;pdf;reader;guided;panel;
